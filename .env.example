# Set server environment variables before starting uvicorn.
# .env is NOT loaded automatically. Do not commit secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local durable storage; runtime/analysis.sqlite3 by default
DATASET_STORAGE=sqlite
# Cloud Run: DATASET_STORAGE=gcs, DATASET_BUCKET=<private bucket>; use service account IAM
DATASET_BUCKET=
